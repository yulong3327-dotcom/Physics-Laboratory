AI_BASE_URL=https://ccproxy.yukework.com
AI_API_KEY=
AI_MODEL=gpt-5.5

# Vibe Hub injects PORT. Do not override it on the platform.
# PORT=8888
# PUBLIC_ORIGIN=http://your-slug.vibehub.yukework.com
AI_RATE_LIMIT_PER_MINUTE=30
AI_MAX_CONCURRENT_REQUESTS=4

# Local video studio. Keep real credentials in .env.local (development) / .env (production).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# VIDEO_PYTHON=D:/path/to/python.exe
# VIDEO_FFMPEG=D:/path/to/ffmpeg.exe
# VIDEO_DATA_DIR=D:/video-data
# `npm run dev` uses .video-data-dev by default so it can coexist with the
# persistent video workbench. Set this only when the development server should
# intentionally own a specific video data directory.
# VIDEO_AI_REQUEST_TIMEOUT_MS=95000
# VIDEO_STORYBOARD_BATCH_UTTERANCES=6
# VIDEO_STORYBOARD_BATCH_CHARACTERS=1000
# VIDEO_TTS_CONCURRENCY=2
# VIDEO_GENERATION_TIMEOUT_MS=1800000
# VIDEO_JOB_TIMEOUT_MS=7200000
# VIDEO_PREVIEW_TIMEOUT_MS=120000
# VIDEO_STATIC_TIMEOUT_SECONDS=120
# VIDEO_MANIM_TIMEOUT_SECONDS=600
# VIDEO_VALIDATION_TIMEOUT_SECONDS=600

# Optional Fish.audio / existing TTS platform. Edge validation voices require no API key.
# FISH_TTS_BASE_URL=https://newttstool-vibehub.suanshubang.cc
FISH_API_KEY=
# FISH_AUDIO_API_KEY= # Compatible alias; FISH_API_KEY takes precedence when nonblank.
# FISH_TTS_TOKEN=
