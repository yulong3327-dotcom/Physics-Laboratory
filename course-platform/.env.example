PORT=4310
TRUST_PROXY=0
NODE_ENV=development
DEMO_MODE=true
DATABASE_PATH=./server/data/courses.sqlite
UPLOAD_DIR=./server/data/uploads
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
# Production: set DEMO_MODE=false, HTTPS public origin, a strong unique password and secret.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
PUBLIC_ORIGIN=http://localhost:4310
WECHAT_APP_ID=wx949b46069f25443e
WECHAT_APP_SECRET=
# WeChat mini-program virtual payment. 0 = production, 1 = sandbox.
# Keep the OfferID empty until enabled; AppKey must match the selected environment.
WECHAT_VIRTUAL_OFFER_ID=
WECHAT_VIRTUAL_ENV=1
WECHAT_VIRTUAL_APP_KEY=
# WeChat message push URL: https://your-domain/api/payments/wechat-virtual/notify
# Token and 43-character EncodingAESKey must match the WeChat console.
WECHAT_MESSAGE_TOKEN=
WECHAT_MESSAGE_AES_KEY=
# Optional approved HTTPS video-source hostnames, comma-separated. Uploaded videos need no entry.
VIDEO_REMOTE_HOSTS=
# Tencent Cloud SMS; configure a Mainland China signature and one-code template.
SMS_PROVIDER=tencent
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# Optional compatible SMS HTTP adapter instead of Tencent.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_TEMPLATE=login
# Optional conventional WeChat Pay (web Native / mini-program JSAPI), separate from virtual payment.
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_CERT_PATH=
WECHAT_PLATFORM_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=
