# Windows Server example only. Copy to the project root as .env on the server.
# Fill secrets locally on the server; do not upload this file with real values.
PORT=4310
HOST=127.0.0.1
TRUST_PROXY=1
NODE_ENV=production
DEMO_MODE=false
DATABASE_PATH=./server/data/production/courses.sqlite
UPLOAD_DIR=./server/data/production/uploads
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
PUBLIC_ORIGIN=https://course.yulongchemistry.cn
WECHAT_APP_ID=wx949b46069f25443e
WECHAT_APP_SECRET=
# WeChat mini-program virtual payment. 0 = production, 1 = sandbox.
# Select the intended environment before creating orders; use its matching AppKey.
WECHAT_VIRTUAL_OFFER_ID=
WECHAT_VIRTUAL_ENV=0
WECHAT_VIRTUAL_APP_KEY=
# Configure this URL in WeChat: https://course.yulongchemistry.cn/api/payments/wechat-virtual/notify
# Token and 43-character EncodingAESKey must match the WeChat console.
WECHAT_MESSAGE_TOKEN=
WECHAT_MESSAGE_AES_KEY=
# Optional approved HTTPS video-source hostnames, comma-separated. Uploaded videos need no entry.
VIDEO_REMOTE_HOSTS=
SMS_PROVIDER=tencent
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# Optional conventional WeChat Pay (web Native / mini-program JSAPI), separate from virtual payment.
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=./secrets/apiclient_key.pem
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_CERT_PATH=./secrets/wechatpay_platform.pem
WECHAT_PLATFORM_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://course.yulongchemistry.cn/api/payments/wechat/notify
# Tencent VOD. Keep credentials server-side. See deploy/windows/VOD.md.
TENCENT_VOD_SECRET_ID=
TENCENT_VOD_SECRET_KEY=
TENCENT_VOD_SUB_APP_ID=1458910441
TENCENT_VOD_REGION=ap-guangzhou
TENCENT_VOD_STORAGE_REGION=ap-guangzhou
TENCENT_VOD_TRANSCODE_DEFINITION=100230
TENCENT_VOD_PLAYBACK_DOMAIN=
TENCENT_VOD_URL_KEY=
TENCENT_VOD_URL_TTL_SECONDS=3600
