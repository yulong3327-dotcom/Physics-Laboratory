page{background:#f7f8fa;color:#24262b;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;font-size:28rpx;line-height:1.6}view,text,input,button{box-sizing:border-box}button{margin:0;padding:0;border-radius:18rpx;font-size:28rpx;font-weight:600}button::after{border:0}button[disabled]{opacity:.5}input{min-height:80rpx}button.primary,.primary{background:#ff861f;color:#fff}.secondary{background:#fff0e2;color:#e47718}.ghost{background:#fff;color:#646b77;border:1rpx solid #e8eaef}.page{padding:32rpx 32rpx 52rpx}.tab-page{padding-bottom:190rpx}.page-title{font-size:44rpx;line-height:1.3;font-weight:800;letter-spacing:1rpx}.eyebrow{font-size:20rpx;letter-spacing:4rpx;font-weight:700;color:#9ba0aa}.subtitle{font-size:25rpx;color:#9296a1;margin-top:12rpx}.card{background:#fff;border-radius:28rpx;padding:30rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin:40rpx 0 22rpx}.section-title{font-weight:750;font-size:34rpx}.section-link{color:#9ba0aa;font-size:24rpx}.muted{color:#969ba4}.small{font-size:23rpx}.row{display:flex;align-items:center}.between{display:flex;align-items:center;justify-content:space-between}.spacer{flex:1}.badge{display:inline-block;font-size:21rpx;line-height:1.5;background:#fff2e6;color:#e7842d;padding:5rpx 12rpx;border-radius:7rpx}.tag{display:inline-block;border-radius:8rpx;background:#f4f5f7;color:#858b96;padding:5rpx 13rpx;margin-right:10rpx;margin-top:8rpx;font-size:21rpx}.avatar{width:66rpx;height:66rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(135deg,#f6b478,#d98b55);font-size:26rpx;font-weight:700;flex-shrink:0;overflow:hidden}.avatar image{width:100%;height:100%}.empty{padding:72rpx 24rpx;text-align:center;background:#fff;border-radius:28rpx}.empty-icon{font-size:56rpx;color:#f0b67e;line-height:1;margin-bottom:25rpx}.empty-title{font-size:30rpx;font-weight:600}.empty-copy{color:#9499a3;margin:12rpx 0 28rpx;font-size:25rpx}.empty button{padding:0 36rpx;display:inline-block;line-height:78rpx}.notice{padding:20rpx 24rpx;background:#fff3e8;color:#b57736;border-radius:16rpx;font-size:23rpx;margin:22rpx 0}.error-card{padding:36rpx;text-align:center;color:#969ba4}.error-card button{margin-top:20rpx;padding:0 30rpx;display:inline-block;line-height:70rpx}.divider{height:1rpx;background:#f0f1f4;margin:24rpx 0}.chevron{font-size:36rpx;color:#bfc3cb;line-height:1}.money{color:#f07d21;font-size:39rpx;font-weight:800}.money-unit{font-size:24rpx;margin-right:3rpx}.old-price{font-size:22rpx;text-decoration:line-through;color:#b4b7bf;margin-left:14rpx;font-weight:400}.filter-row{display:flex;gap:14rpx;white-space:nowrap}.filter{padding:12rpx 24rpx;border:1rpx solid #e5e7eb;background:#fff;color:#7c818c;border-radius:14rpx;font-size:24rpx}.filter.active{background:#fff0e1;border-color:#ffc994;color:#e47a1d}.fixed-footer{position:fixed;bottom:0;left:0;right:0;z-index:9;padding:22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -8rpx 30rpx rgba(30,35,45,.035)}.fixed-footer button{line-height:88rpx}.loading{color:#9a9faa;text-align:center;padding:80rpx 0;font-size:26rpx}.pill-dot{width:11rpx;height:11rpx;background:#ff8b2b;border-radius:50%;margin-right:10rpx}.progress-track{height:7rpx;background:#f1f2f5;border-radius:7rpx;overflow:hidden}.progress-fill{height:100%;background:#ff9a42;border-radius:7rpx}
