<view wx:if="{{visible}}" class="contact-mask" catchtouchmove="stop"><view class="contact-dialog"><view class="contact-title">填写联系信息</view><view class="contact-copy">方便课程服务与讲义寄送。可稍后在个人中心补充或修改。</view><view class="contact-label">联系手机号</view><input type="number" maxlength="11" value="{{phone}}" bindinput="inputPhone" placeholder="请输入联系手机号" disabled="{{saving}}"/><view class="contact-label">微信号</view><input maxlength="20" value="{{wechatId}}" bindinput="inputWechat" placeholder="请输入你的微信号" disabled="{{saving}}"/><view class="contact-hint">由你自行填写，未经短信或微信号验证；不会用于登录。</view><view wx:if="{{error}}" class="contact-error">{{error}}</view><button class="contact-save" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存联系信息</button><button class="contact-skip" bindtap="skip" disabled="{{saving}}">稍后填写</button></view></view>
