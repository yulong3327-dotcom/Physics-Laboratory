.contact-mask{position:fixed;inset:0;z-index:100;background:rgba(25,30,40,.4);display:flex;align-items:center;justify-content:center;padding:36rpx}.contact-dialog{width:100%;max-height:90vh;overflow-y:auto;background:#fff;border-radius:28rpx;padding:36rpx;box-sizing:border-box}.contact-title{font-size:34rpx;font-weight:700;color:#252831}.contact-copy,.contact-hint{font-size:24rpx;color:#8b919b;line-height:1.65;margin:14rpx 0 22rpx}.contact-label{font-size:25rpx;color:#555e6c;margin:22rpx 0 8rpx}.contact-dialog input{background:#f7f8fa;border:1rpx solid #edf0f4;border-radius:14rpx;min-height:84rpx;padding:0 20rpx;font-size:27rpx;box-sizing:border-box}.contact-hint{font-size:22rpx}.contact-error{color:#c15a35;font-size:24rpx;margin:14rpx 0}.contact-dialog button{border:0;border-radius:16rpx;font-size:27rpx;line-height:82rpx}.contact-dialog button::after{border:0}.contact-save{background:#ff861f;color:white}.contact-skip{background:white;color:#969ca6;margin-top:10rpx}.contact-dialog button[disabled]{opacity:.5}
