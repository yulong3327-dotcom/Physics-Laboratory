<view class="course-card" bindtap="open"><view class="course-top"><view class="subject-mark" style="background:{{course.color || '#ff8a21'}}">{{course.subject}}</view><view class="course-info"><view class="course-title">{{course.title}}</view><view class="course-subtitle">{{course.subtitle}}</view></view></view><view class="teacher-row"><view class="teacher-avatar" style="background:{{course.color || '#ff8a21'}}"><image wx:if="{{course.teacherAvatar}}" src="{{course.teacherAvatar}}" mode="aspectFill"/><text wx:else>{{course.teacherInitial}}</text></view><view class="teacher-name">{{course.teacher}}<text>{{course.teacherTitle || '主讲老师'}}</text></view><text class="course-count">{{course.lessonCount}} 节 · {{course.hours}} 分钟</text></view><view class="tags"><text class="tag">{{course.grade}}</text><text class="tag">{{course.type}}</text><text class="tag" wx:for="{{course.tags}}" wx:key="*this">{{item}}</text></view><view class="course-bottom" wx:if="{{mode === 'discover'}}"><view><text class="price">{{course.price > 0 ? '¥' + course.priceText : '免费'}}</text><text wx:if="{{course.originalPrice > course.price}}" class="original">¥{{course.originalPrice}}</text></view><view class="learn-action">{{course.enrolled ? '继续学习' : '查看课程'}} <text>↗</text></view></view><view wx:else class="progress-bottom"><view class="progress-header"><text>{{course.progressPercent >= 100 ? '真棒！已完成全部学习' : '已学习 ' + course.completedLessons + ' / ' + course.lessonCount + ' 节'}}</text><text class="percent">{{course.progressPercent}}%</text></view><view class="progress-track"><view class="progress-fill" style="width:{{course.progressPercent}}%"></view></view></view></view>
