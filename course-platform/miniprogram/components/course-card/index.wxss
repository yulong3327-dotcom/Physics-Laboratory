.course-card{background:#fff;border-radius:28rpx;padding:30rpx;margin-bottom:22rpx}.course-top{display:flex;gap:20rpx}.subject-mark{width:78rpx;height:78rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff;border-radius:18rpx;font-size:25rpx;font-weight:650;opacity:.88}.course-info{min-width:0}.course-title{font-size:31rpx;line-height:1.45;font-weight:750;color:#24262b}.course-subtitle{font-size:23rpx;color:#a0a4ad;margin-top:8rpx;line-height:1.5}.teacher-row{display:flex;align-items:center;margin-top:27rpx}.teacher-avatar{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-size:20rpx;font-weight:600;border-radius:50%;overflow:hidden;opacity:.8;flex-shrink:0}.teacher-avatar image{width:100%;height:100%}.teacher-name{font-size:24rpx;color:#626a75;margin-left:13rpx}.teacher-name text{color:#adb1b9;margin-left:12rpx;font-size:20rpx}.course-count{font-size:20rpx;color:#a4a8b1;margin-left:auto}.tags{margin-top:18rpx}.tag{display:inline-block;border-radius:7rpx;background:#f7f8fa;color:#9399a4;padding:3rpx 12rpx;margin-right:9rpx;margin-top:8rpx;font-size:19rpx}.course-bottom{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #f2f3f6;margin-top:24rpx;padding-top:22rpx}.price{font-size:33rpx;font-weight:750;color:#f08733}.original{margin-left:12rpx;color:#b8bcc4;font-size:21rpx;text-decoration:line-through}.learn-action{padding:10rpx 20rpx;background:#fff2e6;color:#df822e;font-size:23rpx;border-radius:12rpx;font-weight:600}.learn-action text{margin-left:8rpx}.progress-bottom{border-top:1rpx solid #f2f3f6;margin-top:24rpx;padding-top:22rpx}.progress-header{display:flex;justify-content:space-between;font-size:22rpx;color:#a1a6af;margin-bottom:16rpx}.percent{color:#f08c3a}.progress-track{height:6rpx;background:#f3f4f6;border-radius:6rpx;overflow:hidden}.progress-fill{background:#ff9a46;height:100%;border-radius:6rpx}
