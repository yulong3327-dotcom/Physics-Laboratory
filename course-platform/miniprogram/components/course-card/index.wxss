.course-card{background:#fff;border-radius:28rpx;padding:30rpx;margin-bottom:22rpx}.course-top{display:flex;gap:20rpx}.subject-mark{width:78rpx;height:78rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff;border-radius:18rpx;font-size:25rpx;font-weight:650;opacity:.88}.course-info{min-width:0}.course-title{font-size:31rpx;line-height:1.45;font-weight:750;color:#2b3329}.course-subtitle{font-size:23rpx;color:#838877;margin-top:8rpx;line-height:1.5}.teacher-row{display:flex;align-items:center;margin-top:27rpx}.teacher-avatar{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-size:20rpx;font-weight:600;border-radius:50%;overflow:hidden;opacity:.8;flex-shrink:0}.teacher-avatar image{width:100%;height:100%}.teacher-name{font-size:24rpx;color:#626a75;margin-left:13rpx}.teacher-name text{color:#838877;margin-left:12rpx;font-size:20rpx}.course-count{font-size:20rpx;color:#838877;margin-left:auto}.tags{margin-top:18rpx}.tag{display:inline-block;border-radius:7rpx;background:#f7f3e9;color:#838877;padding:3rpx 12rpx;margin-right:9rpx;margin-top:8rpx;font-size:19rpx}.course-bottom{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #eae3d6;margin-top:24rpx;padding-top:22rpx}.price{font-size:33rpx;font-weight:750;color:#b45f38}.original{margin-left:12rpx;color:#b8bcc4;font-size:21rpx;text-decoration:line-through}.learn-action{padding:10rpx 20rpx;background:#f3e6d6;color:#df822e;font-size:23rpx;border-radius:12rpx;font-weight:600}.learn-action text{margin-left:8rpx}.progress-bottom{border-top:1rpx solid #eae3d6;margin-top:24rpx;padding-top:22rpx}.progress-header{display:flex;justify-content:space-between;font-size:22rpx;color:#838877;margin-bottom:16rpx}.percent{color:#f08c3a}.progress-track{height:6rpx;background:#eae3d6;border-radius:6rpx;overflow:hidden}.progress-fill{background:#c97b4c;height:100%;border-radius:6rpx}
.course-card{background:#fffdf7;border:1rpx solid #e3dbc9;border-radius:24rpx;padding:27rpx}.subject-mark{background:#c2774a!important;color:#fff9eb;opacity:1;border-radius:16rpx}.course-title{color:#30392b}.course-subtitle{color:#7d8571}.teacher-avatar{opacity:1;background:#dbccb6!important;color:#766347}.teacher-name{color:#66715b}.teacher-name text{color:#858d76}.course-count{color:#858d76}.tags .tag{background:#eeecdf;color:#7c856b}.learn-action{background:#efe3cd;color:#9e6239;border-radius:11rpx}.price{color:#b15e37}.original{color:#9b9d8d}.progress-header{color:#818974}.percent{color:#aa6f42}.progress-fill{background:#b7794d}
