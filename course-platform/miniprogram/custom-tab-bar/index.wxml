<view class="tabbar"><view wx:for="{{items}}" wx:key="path" class="tab {{selected === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="switchTab"><view class="icon {{item.icon}}"><view wx:if="{{item.icon === 'courses'}}" class="play"></view><view wx:if="{{item.icon === 'profile'}}" class="head"></view><view wx:if="{{item.icon === 'discover'}}" class="compass"></view></view><text>{{item.text}}</text><view class="active-dot" wx:if="{{selected === index}}"></view></view></view>
