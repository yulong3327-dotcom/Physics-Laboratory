.tabbar{position:fixed;bottom:0;left:0;right:0;display:flex;padding:19rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #f1f2f5;z-index:20;border-radius:26rpx 26rpx 0 0;box-shadow:0 -8rpx 40rpx rgba(30,35,45,.025)}.tab{flex:1;display:flex;align-items:center;flex-direction:column;position:relative;color:#9b9fa7;font-size:22rpx;gap:8rpx}.selected{color:#f58225;font-weight:600}.icon{width:40rpx;height:40rpx;border:3rpx solid currentColor;position:relative;box-sizing:border-box}.discover{border-radius:50%}.compass{position:absolute;left:10rpx;top:8rpx;width:13rpx;height:20rpx;transform:rotate(35deg);background:currentColor;border-radius:3rpx}.courses{border-radius:11rpx}.selected .courses{background:#ff8a27;border-color:#ff8a27}.play{width:0;height:0;border-top:8rpx solid transparent;border-bottom:8rpx solid transparent;border-left:12rpx solid currentColor;position:absolute;top:9rpx;left:13rpx}.selected .play{color:#fff}.profile{border:0;border-bottom:3rpx solid currentColor;border-radius:50%;height:38rpx}.head{width:17rpx;height:17rpx;border:3rpx solid currentColor;border-radius:50%;position:absolute;top:0;left:11rpx}.profile::after{content:'';position:absolute;left:3rpx;bottom:0;width:34rpx;height:16rpx;border:3rpx solid currentColor;border-bottom:0;border-radius:22rpx 22rpx 0 0}.active-dot{position:absolute;top:-10rpx;right:65rpx;background:#ff8a27;border-radius:50%;width:7rpx;height:7rpx}
