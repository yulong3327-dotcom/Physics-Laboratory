ight:650;margin-top:27rpx;line-height:1.5}.bilibili-uid{font-size:23rpx;color:#bbc3b1;margin-top:9rpx}.bilibili-button{margin-top:26rpx;background:#edf0e2;color:#252d25;font-size:26rpx;line-height:84rpx}.bilibili-help{font-size:21rpx;line-height:1.7;color:#bbc3b1;margin-top:16rpx}.explore-button{line-height:86rpx;margin-top:28rpx}.brand-footer{color:#8e9283;font-size:21rpx;text-align:center;margin-top:36rpx}
