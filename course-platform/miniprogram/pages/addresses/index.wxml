<view class="page"><view class="eyebrow">SHIPPING ADDRESS</view><view class="page-title">收货地址<text class="title-dot">.</text></view><view class="subtitle">用于寄送课程配套的实物讲义</view><view wx:if="{{loading}}" class="loading">正在获取地址…</view><view wx:elif="{{error}}" class="card error-card">{{error}}<button class="secondary" bindtap="load">重试</button></view><view wx:elif="{{!addresses.length}}" class="empty"><view class="empty-icon">⌂</view><view class="empty-title">还没有收货地址</view><view class="empty-copy">添加地址后，可在已付款订单申请寄送讲义</view></view><block wx:else><view class="address-card card" wx:for="{{addresses}}" wx:key="id"><view class="between"><view class="recipient">{{item.recipient}} <text>{{item.phone}}</text></view><view wx:if="{{item.isDefault}}" class="badge">默认</view></view><view class="address-text">{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</view><view class="address-actions"><button class="ghost" data-id="{{item.id}}" bindtap="edit" disabled="{{saving || deletingId}}">编辑</button><button class="ghost" data-id="{{item.id}}" bindtap="remove" disabled="{{saving || deletingId}}">{{deletingId === item.id ? '删除中' : '删除'}}</button></view></view></block><button class="primary add-button" bindtap="add" disabled="{{saving || deletingId}}">＋ 新增收货地址</button><view class="notice">发货前可在寄送记录中更换地址；编辑地址簿不会自动修改已提交的寄送申请。</view></view>
<view wx:if="{{editing}}" class="form-mask" catchtouchmove="stop"><view class="form-card"><view class="form-title">{{editingId ? '编辑收货地址' : '新增收货地址'}}</view><view class="field-label">收件人</view><input maxlength="50" value="{{form.recipient}}" data-field="recipient" bindinput="input" placeholder="请输入收件人姓名" disabled="{{saving}}"/><view class="field-label">收件手机号</view><input type="number" maxlength="11" value="{{form.phone}}" data-field="phone" bindinput="input" placeholder="请输入 11 位手机号" disabled="{{saving}}"/><view class="field-label">所在地区</view><picker mode="region" value="{{region}}" bindchange="region" disabled="{{saving}}"><view class="region-field">{{form.province ? form.province + ' ' + form.city + ' ' + form.district : '请选择省、市、区县'}} <text>›</text></view></picker><view class="field-label">详细地址</view><textarea maxlength="500" value="{{form.detail}}" data-field="detail" bindinput="input" placeholder="街道、门牌号等详细信息" disabled="{{saving}}"/><view class="default-row" bindtap="toggleDefault"><text class="check {{form.isDefault ? 'checked' : ''}}">{{form.isDefault ? '✓' : ''}}</text>设为默认收货地址</view><view wx:if="{{formError}}" class="form-error">{{formError}}</view><button class="primary save-button" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存地址</button><button class="cancel-button" bindtap="close" disabled="{{saving}}">取消</button></view></view>
