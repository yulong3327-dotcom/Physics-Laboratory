<view wx:if="{{loading}}" class="loading">正在打开课程…</view>
<view wx:elif="{{error}}" class="page"><view class="card error-card">{{error}}<button class="secondary" bindtap="load">重新加载</button></view></view>
<view wx:elif="{{course}}" class="course-page">
  <image wx:if="{{course.coverImage && !imageErrors.cover}}" src="{{course.coverImage}}" mode="widthFix" class="course-cover" data-key="cover" binderror="imageFailed"/>
  <view class="course-header">
    <view class="course-kicker"><text>{{course.subject}} · {{course.grade}}</text><button open-type="share" class="share-button">分享 ↗</button></view>
    <view class="course-title">{{course.title}}</view><view class="course-subtitle">{{course.subtitle}}</view>
    <view wx:if="{{course.isInternalTest}}" class="notice internal-test">内测课程 · 用于验证购买、看课和讲义下载，请按页面所列内容购买。</view>
    <view class="teacher"><view class="avatar" style="background:{{course.color}}">{{course.teacherInitial}}</view><view class="teacher-info"><view>{{course.teacher}}</view><text>{{course.teacherTitle || '主讲老师'}}</text></view><view class="lesson-count">{{course.lessonCount}} 节课时<text>{{course.hours}} 分钟内容</text></view></view>
    <view class="tags"><text class="tag" wx:for="{{course.tags}}" wx:key="*this">{{item}}</text></view>
    <view class="owned-strip" wx:if="{{course.enrolled}}"><view class="pill-dot"></view>已加入学习<text>已完成 {{completed}} / {{course.lessonCount}} 节</text></view>
  </view>
  <view class="quick-tools"><view bindtap="materials"><view class="tool-icon tool-blue">▤</view><text>课程资料</text></view><view><view class="tool-icon tool-green">▶</view><text>随时回看</text></view><view><view class="tool-icon tool-yellow">✓</view><text>进度记录</text></view><view><view class="tool-icon tool-orange">✦</view><text>专注学习</text></view></view>
  <view class="course-content">
    <view class="course-tabs" id="course-tabs"><view class="{{tab === 'details' ? 'active' : ''}}" data-tab="details" bindtap="switchTab">课程介绍</view><view class="{{tab === 'lessons' ? 'active' : ''}}" data-tab="lessons" bindtap="switchTab">课程目录<text>{{lessons.length}}</text></view><view class="{{tab === 'materials' ? 'active' : ''}}" data-tab="materials" bindtap="switchTab">配套讲义<text>{{materials.length}}</text></view></view>
    <view wx:if="{{tab === 'details'}}">
      <view class="description-card card"><view class="description-title"><view></view>关于这门课</view><text class="description" selectable>{{course.description || '老师精心准备的学习内容，带你一步一步扎实进步。'}}</text></view>
      <view class="detail-gallery" wx:if="{{course.detailImages.length}}"><block wx:for="{{course.detailImages}}" wx:key="*this"><image wx:if="{{!imageErrors[index]}}" src="{{item}}" mode="widthFix" lazy-load class="detail-image" data-key="{{index}}" data-index="{{index}}" bindtap="previewImage" binderror="imageFailed"/><view wx:else class="image-error">此张课程介绍图片暂时无法加载</view></block></view>
      <button class="secondary view-lessons" data-tab="lessons" bindtap="switchTab">查看课程目录（{{lessons.length}} 节） →</button>
    </view>
    <view wx:elif="{{tab === 'lessons'}}">
      <view class="lesson-card card" wx:for="{{lessons}}" wx:key="id" data-id="{{item.id}}" bindtap="play"><view class="lesson-number {{item.completed ? 'done' : ''}}">{{item.completed ? '✓' : item.number}}</view><view class="lesson-info"><view class="lesson-title">{{item.title}}</view><view class="lesson-meta"><text>{{item.durationText}}</text><text wx:if="{{item.completed}}" class="completed-text">已学完</text><text wx:elif="{{item.isPreview}}" class="preview-tag">可试看</text><text wx:elif="{{!course.canWatch}}">购买后学习</text><text wx:elif="{{item.progress > 0}}">学习中</text></view></view><text class="lesson-arrow">{{course.canWatch || item.isPreview ? '▶' : '›'}}</text></view>
      <view wx:if="{{!lessons.length}}" class="empty"><view class="empty-title">课时正在准备中</view><view class="empty-copy">敬请期待老师的精彩内容</view></view>
    </view>
    <view wx:else><view class="notice" wx:if="{{!course.enrolled}}">加入课程后，即可下载配套讲义资料。</view><view class="material-card card" wx:for="{{materials}}" wx:key="id" data-id="{{item.id}}" bindtap="download"><view class="file-icon">{{item.extension}}</view><view class="file-info"><view>{{item.name}}</view><text>{{item.sizeText}} · 课程配套资料</text></view><view class="file-download">↓</view></view><view wx:if="{{!materials.length}}" class="empty"><view class="empty-title">老师暂未上传讲义</view><view class="empty-copy">上传后会显示在这里</view></view></view>
  </view>
  <view class="fixed-footer purchase-bar"><view class="purchase-price" wx:if="{{!course.enrolled}}"><view class="money"><text class="money-unit" wx:if="{{course.price > 0}}">¥</text>{{course.price > 0 ? course.priceText : '免费'}}<text wx:if="{{course.originalPrice > course.price}}" class="old-price">¥{{course.originalPrice}}</text></view><text class="small muted">{{course.lessonCount}} 节{{course.isInternalTest ? '内测内容' : '系统课程'}}</text></view><view wx:else class="enrolled-label"><view>学习进度 {{course.progressPercent}}%</view><view class="progress-track"><view class="progress-fill" style="width:{{course.progressPercent}}%"></view></view></view><button class="primary" bindtap="action">{{course.enrolled ? '继续学习' : course.price > 0 ? '立即购买' : '免费加入学习'}}<text> →</text></button></view>
</view>
