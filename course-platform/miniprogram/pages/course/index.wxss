.course-page{padding-bottom:190rpx}.course-header{background:#fff;padding:24rpx 34rpx 28rpx}.course-kicker{display:flex;align-items:center;justify-content:space-between;color:#b09277;font-size:21rpx}.share-button{margin-left:auto;background:#f9f5f1;border-radius:10rpx;padding:8rpx 14rpx;color:#ae9076;font-size:21rpx;line-height:1.4;font-weight:400}.course-title{font-weight:800;font-size:43rpx;line-height:1.5;margin-top:15rpx}.course-subtitle{font-size:25rpx;color:#9da2ad;margin-top:13rpx}.teacher{display:flex;align-items:center;margin-top:30rpx}.avatar{width:72rpx;height:72rpx;opacity:.85}.teacher-info{margin-left:18rpx;font-size:27rpx;color:#737b87}.teacher-info text{font-size:21rpx;color:#aab0ba}.lesson-count{margin-left:auto;font-size:23rpx;color:#929ba7;text-align:right}.lesson-count text{display:block;font-size:20rpx;color:#b2b7c0}.tags{margin-top:20rpx}.owned-strip{display:flex;align-items:center;border-top:1rpx solid #f1f2f5;padding-top:22rpx;margin-top:24rpx;font-size:22rpx;color:#d89962}.owned-strip text{margin-left:auto;color:#aab1bc}.owned-strip .pill-dot{width:8rpx;height:8rpx}.quick-tools{padding:26rpx 20rpx 32rpx;background:#fff;display:flex;border-top:1rpx solid #fafafa}.quick-tools>view{flex:1;display:flex;align-items:center;flex-direction:column;gap:14rpx;font-size:23rpx;color:#9a9fa9}.tool-icon{width:55rpx;height:55rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;font-size:27rpx;box-shadow:5rpx 5rpx 0 rgba(170,190,200,.1);color:#fff}.tool-blue{background:linear-gradient(130deg,#7bd5f5,#58b6f1)}.tool-green{background:linear-gradient(130deg,#5cddb1,#35c892)}.tool-yellow{background:linear-gradient(130deg,#ffda6b,#ffbd3d)}.tool-orange{background:linear-gradient(130deg,#ffa75a,#ff8b2a)}.course-content{padding:26rpx 28rpx}.description-card{padding:27rpx}.description-title{font-size:27rpx;font-weight:700;display:flex;align-items:center;gap:12rpx;margin-bottom:13rpx}.description-title>view{height:25rpx;width:5rpx;background:#f