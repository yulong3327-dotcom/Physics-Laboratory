<view class="page tab-page">
  <view class="brand-header"><view class="brand-mark">YL</view><view><view class="brand-name">{{brand.name}}</view><view class="brand-byline">玉龙的化学课堂 / YULONG</view></view><button class="about-link" bindtap="about">认识玉龙 ↗</button></view>
  <view class="hero">
    <view class="hero-kicker"><view></view>玉龙老师的线上课堂</view>
    <view class="hero-title">学化学，<view>和玉龙一起。</view></view>
    <view class="hero-description">把知识讲清楚，<view>让每一次理解更扎实。</view></view>
    <button class="hero-button" bindtap="explore">看看我的课程 <text>↗</text></button>
    <view class="hero-art"><view class="orbit orbit-one"></view><view class="orbit orbit-two"></view><view class="creator-monogram"><image src="/assets/yulong-avatar.webp" mode="aspectFill"/><view>玉龙化学</view></view><view class="chem-label">CHEMISTRY<view>with YULONG</view></view><view class="hero-star">✦</view></view>
    <view class="hero-bottom"><text>理解 · 练习 · 回看</text><text>一起学扎实 / 01</text></view>
  </view>
  <view class="creator-entry" bindtap="about"><view class="entry-mark">玉龙<text>的日常</text></view><view class="entry-copy"><view>课程之外，在 B站见</view><text>了解我 · 访问我的 B站主页</text></view><text class="entry-arrow">↗</text></view>
  <view class="section-head" id="course-list"><view><view class="eyebrow">THE CLASSROOM</view><view class="section-title">玉龙的课程</view></view><picker mode="selector" range="{{grades}}" bindchange="chooseGrade"><view class="section-link">{{grade}} ⌄</view></picker></view>
  <view class="search-box"><text class="search-icon"></text><input placeholder="搜索课程或知识点" value="{{search}}" bindinput="searchInput" bindconfirm="search" confirm-type="search"/><view bindtap="search" class="search-submit">搜索</view></view>
  <scroll-view scroll-x class="subjects"><view class="filter-row"><view wx:for="{{subjects}}" wx:key="*this" data-value="{{item}}" bindtap="chooseSubject" class="filter {{subject === item ? 'active' : ''}}">{{item}}</view></view></scroll-view>
  <view wx:if="{{demoMode}}" class="demo-note"><view class="pill-dot"></view>演示环境 · 课程与交易仅用于功能体验</view>
  <view wx:if="{{loading}}" class="loading">正在打开玉龙的课程…</view>
  <view wx:elif="{{error}}" class="error-card card"><view>{{error}}</view><button class="secondary" bindtap="load">重新加载</button></view>
  <view wx:elif="{{!courses.length}}" class="empty"><view class="empty-icon">▤</view><view class="empty-title">暂时没有匹配的课程</view><view class="empty-copy">试试其他科目或搜索词</view><button class="secondary" bindtap="reset">查看全部课程</button></view>
  <block wx:else><course-card wx:for="{{courses}}" wx:key="id" course="{{item}}"/></block>
  <view class="footer-copy">{{brand.name}} · 认真对待每一次理解</view>
</view>
