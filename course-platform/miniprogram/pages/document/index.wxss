.eyebrow{margin-bottom:14rpx}.document-title{font-size:34rpx;font-weight:700;line-height:1.6}.document-toolbar{display:flex;align-items:center;justify-content:space-between;margin:22rpx 0 25rpx;font-size:20rpx;color:#a6b0bd}.document-toolbar>view{color:#d49b67;background:#eee2cf;padding:7rpx 14rpx;border-radius:8rpx}.document-content{padding:31rpx 27rpx;font-size:26rpx;line-height:2;color:#687585;white-space:pre-wrap;word-break:break-word}.document-tip{text-align:center;font-size:20rpx;color:#b7c0cb;margin-top:30rpx}
.document-toolbar,.document-tip{color:#818e72}.document-toolbar>view{color:#a87446;background:#eee2cf}.document-content{color:#58694b}
