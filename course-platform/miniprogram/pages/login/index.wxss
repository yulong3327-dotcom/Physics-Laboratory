.login-page{padding-top:55rpx}.login-brand{position:relative;width:90rpx;height:90rpx;background:#ff8a26;color:#fff;border-radius:27rpx;display:flex;align-items:center;justify-content:center;font-size:47rpx;font-weight:800;transform:rotate(-5deg);margin-bottom:30rpx}.login-brand>view{position:absolute;right:-8rpx;top:0;width:15rpx;height:15rpx;border-radius:50%;background:#ffc57f}.login-eyebrow{font-size:19rpx;letter-spacing:4rpx;color:#b7a28e;font-weight:600}.login-title{font-size:47rpx;font-weight:800;line-height:1.4;margin-top:12rpx}.login-copy{color:#9da2ad;font-size:25rpx;margin-top:11rpx}.login-panel{margin-top:44rpx;padding:32rpx}.login-tabs{display:flex;gap:42rpx;border-bottom:1rpx solid #f0f1f5}.login-tabs>view{font-size:29rpx;color:#a4a9b2;padding-bottom:22rpx;position:relative}.login-tabs>view.active{font-weight:750;color:#292c33}.login-tabs>view.active::after{content:'';position:absolute;bottom:0;left:0;width:40rpx;height:5rpx;border-radius:4rpx;background:#ff8b2a}.wechat-panel{text-align:center;padding-top:35rpx}.wechat-mark{position:relative;width:100rpx;height:80rpx;margin:0 auto 24rpx}.wechat-mark>view:first-child{width:78rpx;height:60rpx;position:absolute;top:0;left:0;background:#dff1e5;border-radius:50%}.wechat-mark>view:nth-child(2){width:55rpx;height:45rpx;position:absolute;top:27rpx;right:0;background:#81c99b;border-radius:50%}.wechat-mark>text{position:absolute;top:22rpx;right:11rpx;font-size:12rpx;letter-spacing:6rpx;color:#fff}.wechat-title{font-size:29rpx;font-weight:600}.wechat-copy{font-size:22rpx;color:#a1a8b2;line-height:1.8;margin:13rpx 0 31rpx}.wechat-button{background:#38ab66;color:#fff;line-height:86rpx;font-size:27rpx}.capability-hint{text-align:center;color:#a9aeb7;font-size:20rpx;line-height:1.8;margin-top:20rpx}.field-label{font-size:23rpx;color:#7c838e;margin-top:25rpx;margin-bottom:8rpx}.input-wrap{display:flex;align-items:center;border-bottom:1rpx solid #e8ebf0;gap:20rpx}.input-wrap>text{font-size:25rpx;color:#6d7582;padding-right:19rpx;border-right:1rpx solid #e8ebf0}.input-wrap input{font-size:27rpx;flex:1;min-width:0}.input-wrap button{font-size:22rpx;color:#ed882e;background:none;font-weight:500;flex-shrink:0}.phone-submit{margin-top:36rpx;line-height:86rpx}.consent{display:flex;align-items:flex-start;gap:11rpx;color:#a7adb7;font-size:19rpx;margin-top:31rpx}.checkbox{border:2rpx solid #d6dae1;width:25rpx;height:25rpx;line-height:22rpx;border-radius:7rpx;flex-shrink:0;text-align:center;margin-top:2rpx;font-size:19rpx}.checkbox.checked{background:#ff982f;color:#fff;border-color:#ff982f}.login-error{margin-top:22rpx;color:#cf6539;font-size:24rpx;background:#fff6ed;padding:17rpx 20rpx;border-radius:12rpx}.demo-panel{padding:0 32rpx;margin-top:32rpx}.demo-divider{display:flex;align-items:center;gap:22rpx;justify-content:center;margin-bottom:24rpx}.demo-divider>view{height:1rpx;background:#e7e9ee;flex:1}.demo-divider text{font-size:21rpx;color:#acb0b9}.demo-panel button{font-size:25rpx;line-height:78rpx;color:#7c828c}.login-footer{color:#b9bec6;font-size:20rpx;text-align:center;margin-top:55rpx;letter-spacing:2rpx}
