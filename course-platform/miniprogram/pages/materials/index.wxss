.eyebrow{margin-bottom:10rpx}.title-dot{color:#f89b42;margin-left:5rpx}.course-label{display:flex;align-items:center;font-size:26rpx;color:#818b99;margin:34rpx 0 26rpx;gap:13rpx}.course-label-line{height:25rpx;width:5rpx;background:#ffb369;border-radius:5rpx;flex-shrink:0}.file-card{display:flex;gap:20rpx;align-items:center;padding:29rpx 25rpx;margin-bottom:20rpx}.file-icon{width:68rpx;height:80rpx;display:flex;align-items:center;justify-content:center;background:#fff1e4;color:#dba472;font-size:17rpx;border-radius:8rpx;flex-shrink:0;font-weight:700}.file-content{min-width:0;flex:1}.file-content>view{font-size:26rpx;font-weight:550;line-height:1.6;word-break:break-all}.file-content>text{display:block;margin-top:8rpx;color:#aab4c1;font-size:20rpx}.download-mark{font-size:36rpx;color:#aeb7c4}.materials-tip{text-align:center;font-size:21rpx;color:#b1bac6;margin-top:40rpx;line-height:1.9}.buy-link{margin-top:10rpx;color:#d7965e}
