<view class="page tab-page"><view class="between"><view><view class="eyebrow">MY LEARNING</view><view class="page-title">我的课程<text class="heading-dot">.</text></view></view><picker wx:if="{{courses.length}}" mode="selector" range="{{courseTitles}}" bindchange="chooseMaterials"><view class="download-icon">↓</view></picker><view wx:else class="download-icon" bindtap="materials">↓</view></view><view class="subtitle">每一次认真，都算数。</view>
<view class="learning-summary" wx:if="{{loggedIn}}"><view><view class="summary-number">{{total}}<text>门</text></view><view class="summary-label">已加入课程</view></view><view class="summary-line"></view><view><view class="summary-number">{{completed}}<text>门</text></view><view class="summary-label">已完成课程</view></view><view class="summary-decoration"><view>KEEP</view><view>GOING ✦</view></view></view>
<scroll-view scroll-x class="filters"><view class="filter-row"><picker mode="selector" range="{{subjects}}" data-field="subject" bindchange="choose"><view class="filter {{subject !== '科目' ? 'active' : ''}}">{{subject}}⌄</view></picker><picker mode="selector" range="{{types}}" data-field="type" bindchange="choose"><view class="filter {{type !== '类型' ? 'active' : ''}}">{{type}}⌄</view></picker><picker mode="selector" range="{{grades}}" data-field="grade" bindchange="choose"><view class="filter {{grade !== '年级' ? 'active' : ''}}">{{grade}}⌄</view></picker><picker mode="selector" range="{{statuses}}" data-field="status" bindchange="choose"><view class="filter {{status !== '课程状态' ? 'active' : ''}}">{{status}}⌄</view></picker></view></scroll-view>
<view wx:if="{{!loggedIn}}" class="empty"><view class="empty-icon">▤</view><view class="empty-title">你的学习旅程，从这里开始</view><view class="empty-copy">登录后查看已选课程和学习进度</view><button class="primary" bindtap="login">登录，开始学习</button></view>
<view wx:elif="{{loading}}" class="loading">正在整理你的课程…</view><view wx:elif="{{error}}" class="card error-card"><view>{{error}}</view><button class="secondary" bindtap="load">重新加载</button></view>
<view wx:elif="{{!visible.length}}" class="empty"><view class="empty-icon">▤</view><view class="empty-title">这里还没有课程</view><view class="empty-copy">去发现适合你的课程，开启新的进步</view><button class="secondary" bindtap="discover">发现好课</button></view>
<course-card wx:else wx:for="{{visible}}" wx:key="id" course="{{item}}" mode="my"/>
<view class="learning-footer" wx:if="{{visible.length}}">学习不止，进步不停 <text>✦</text></view></view>
