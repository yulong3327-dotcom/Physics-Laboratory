<view class="page"><view class="eyebrow">MY ORDERS</view><view class="between"><view class="page-title">我的订单<text class="title-dot">.</text></view><view class="refresh" bindtap="refresh">↻ 刷新</view></view><view class="subtitle">玉龙AI优课 · 购买记录与开课状态</view><view class="filter-row order-filters"><view wx:for="{{filters}}" wx:key="*this" class="filter {{filter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="chooseFilter">{{item}}</view></view><view wx:if="{{loading}}" class="loading">正在获取订单…</view><view wx:elif="{{error}}" class="card error-card">{{error}}<button class="secondary" bindtap="load">重新加载</button></view><view wx:elif="{{!visible.length}}" class="empty"><view class="empty-icon">▤</view><view class="empty-title">暂无相关订单</view><view class="empty-copy">好课程，等你来发现</view><button class="secondary" bindtap="discover">发现课程</button></view><block wx:else><view class="order-card card" wx:for="{{visible}}" wx:key="id"><view class="between order-header"><text>{{item.dateText}}</text><text class="status {{item.status}}">{{item.statusText}}</text></view><view class="order-title" data-id="{{item.courseId}}" bindtap="openCourse">{{item.courseTitle}} <text>›</text></view><view class="order-id" data-id="{{item.id}}" bindtap="copy">订单号 {{item.id}} <text>复制</text></view><view class="between order-bottom"><view>实付 <text class="amount">¥{{item.amountText}}</text></view><button wx:if="{{item.status === 'pending'}}" class="primary" data-course="{{item.courseId}}" data-id="{{item.id}}" bindtap="pay">继续支付</button><button wx:elif="{{item.status === 'paid'}}" class="secondary" data-id="{{item.courseId}}" bindtap="openCourse">进入课程</button></view></view></block></view>
