<view class="page tab-page">
  <view class="eyebrow">YULONG / MY LEARNING</view><view class="page-title">我的学习空间</view><view class="subtitle">在玉龙的课堂，记录自己的每一步。</view>
  <view class="profile-card card"><view class="row" bindtap="identity"><view class="profile-avatar">{{initial}}</view><view class="profile-info"><view class="profile-name">{{user ? user.nickname : '欢迎来上课'}}</view><view class="small muted">{{user ? (user.phone || '学员账号 · 点击修改昵称') : '微信登录，接着上一次的进度学'}}</view></view><text class="chevron">›</text></view><button wx:if="{{!user}}" class="primary login-button" bindtap="login">微信认证登录</button><view class="stats" wx:else><view bindtap="courses"><view>{{courseCount}}</view><text>我的课程</text></view><view bindtap="orders"><view>{{orderCount}}</view><text>全部订单</text></view><view bindtap="courses"><view>{{completedCount}}</view><text>完成课程</text></view></view></view>
  <view class="creator-note" bindtap="about"><view class="note-avatar">YL</view><view><view class="note-title">玉龙老师的一句话</view><view class="note-copy">不急着赶路，先把这一步学明白。</view></view><text class="note-arrow">↗</text></view>
  <view class="menu card"><view class="menu-row" bindtap="courses"><view class="menu-symbol orange">▶</view><text>我的课程</text><text class="chevron">›</text></view><view class="menu-row" bindtap="orders"><view class="menu-symbol blue">▤</view><text>我的订单</text><text class="chevron">›</text></view><view class="menu-row" bindtap="editNickname"><view class="menu-symbol green">✎</view><text>修改昵称</text><text class="chevron">›</text></view><button wx:if="{{user && (!user.phone || !user.wechatLinked)}}" open-type="getPhoneNumber" bindgetphonenumber="bindPhone" class="menu-row phone-bind" loading="{{binding}}"><view class="menu-symbol purple">▯</view><text>关联微信与手机号</text><text class="chevron">›</text></button></view>
  <view class="menu card"><view class="menu-row" bindtap="about"><view class="menu-symbol creator-symbol">YL</view><view class="menu-description"><view>关于玉龙</view><text>认识我 · 我的 B站主页</text></view><text class="chevron">↗</text></view><view class="menu-row" bindtap="help"><view class="menu-symbol grey">?</view><text>学习帮助</text><text class="chevron">›</text></view></view>
  <view wx:if="{{demoMode}}" class="notice">当前为演示环境，演示账号与模拟交易仅供功能体验。</view><button wx:if="{{user}}" class="ghost logout" bindtap="logout">退出登录</button><view class="version">{{brand.name}} · 认真对待每一次理解</view>
</view>
