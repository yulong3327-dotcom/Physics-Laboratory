<view class="page tab-page"><view class="eyebrow">MY ZHIKE</view><view class="page-title">个人中心<text class="title-dot">.</text></view><view class="profile-card card"><view class="row" bindtap="identity"><view class="profile-avatar">{{initial}}</view><view class="profile-info"><view class="profile-name">{{user ? user.nickname : '欢迎来到知课'}}</view><view class="small muted">{{user ? (user.wechatLinked ? '微信认证学员' : '让每次学习都有收获') : '登录，开启属于你的学习旅程'}}</view></view><text class="chevron">›</text></view><button wx:if="{{!user}}" class="primary login-button" bindtap="login">立即登录</button><view class="stats" wx:else><view bindtap="courses"><view>{{courseCount}}</view><text>我的课程</text></view><view bindtap="orders"><view>{{orderCount}}</view><text>全部订单</text></view><view bindtap="courses"><view>{{completedCount}}</view><text>完成课程</text></view></view></view>
<view class="encourage"><view class="encourage-star">✦</view><view><view class="encourage-title">慢慢积累，也在闪闪发光</view><view class="small">专注当下的每一课，让进步自然发生</view></view></view>
<view class="menu card"><view class="menu-row" bindtap="courses"><view class="menu-symbol orange">▶</view><text>我的课程</text><text class="chevron">›</text></view><view class="menu-row" bindtap="orders"><view class="menu-symbol blue">▤</view><text>我的订单</text><text class="chevron">›</text></view><view class="menu-row" bindtap="editNickname"><view class="menu-symbol green">✎</view><text>修改昵称</text><text class="chevron">›</text></view><view class="menu-row" bindtap="contacts"><view class="menu-symbol purple">▯</view><text>联系手机号与微信号</text><text class="chevron">›</text></view><view class="menu-row" bindtap="addresses"><view class="menu-symbol blue">⌂</view><text>收货地址管理</text><text class="chevron">›</text></view><view class="menu-row" bindtap="shipments"><view class="menu-symbol orange">▣</view><text>讲义寄送与物流</text><text class="chevron">›</text></view></view>
<view class="menu card"><view class="menu-row" bindtap="help"><view class="menu-symbol grey">?</view><text>学习帮助</text><text class="chevron">›</text></view><view class="menu-row" bindtap="about"><view class="menu-symbol grey">i</view><text>关于知课</text><text class="chevron">›</text></view></view><view wx:if="{{demoMode}}" class="notice">当前为演示环境，演示账号与模拟交易仅供功能体验。</view><button wx:if="{{user}}" class="ghost logout" bindtap="logout">退出登录</button><view class="version">知课 ZHIKE · 学习的每一步，都算数</view></view>

<contact-dialog visible="{{showContact}}" user="{{user}}" bind:saved="contactSaved" bind:close="closeContact"/>
