{
  "name": "circuit-converter",
  "version": "0.1.0",
  "description": "初中物理实物图与电路图自动转化软件",
  "type": "module",
  "scripts": {
    "prompts:generate": "node scripts/generate-prompts.mjs",
    "prompts:check": "node scripts/generate-prompts.mjs --check",
    "predev": "npm run prompts:generate",
    "prebuild": "npm run prompts:generate",
    "pretest": "npm run prompts:generate",
    "pretest:e2e": "npm run prompts:generate",
    "dev": "vite",
    "build": "node scripts/clean-server.mjs && tsc -b && tsc --project tsconfig.node.json && tsc --project tsconfig.server.json && vite build",
    "start": "node server-dist/index.js",
    "package:vibehub": "npm run build && node scripts/package-vibehub.mjs",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "video:sample": "tsx scripts/prepare-power-lesson.ts",
    "video:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-video-runtime.ps1",
    "video:smoke": ".video-runtime/Scripts/python.exe -X utf8 scripts/video-runtime-smoke.py"
  },
  "dependencies": {
    "@tisoap/react-flow-smart-edge": "^5.0.0",
    "@xyflow/react": "^12.8.5",
    "elkjs": "^0.12.0",
    "fflate": "^0.8.3",
    "katex": "^0.18.7",
    "lucide-react": "^0.468.0",
    "mathlive": "^0.110.0",
    "mediabunny": "^1.55.7",
    "ml-matrix": "^6.15.0",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg-path-properties": "^2.1.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.20.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  }
}
